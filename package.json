{
  "name": "mashaallah-electronics-manager",
  "version": "1.0.0",
  "description": "Offline-first electronics store management desktop application",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/**/*.test.js",
    "dist": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "electronics",
    "inventory",
    "pos",
    "desktop",
    "offline"
  ],
  "author": "MashaAllah Electronics",
  "license": "MIT",
  "dependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.mashaallah.electronics.manager",
    "productName": "MashaAllah Electronics Manager",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
